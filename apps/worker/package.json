{
  "name": "@quant-lab/worker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "catalog:refresh": "node dist/catalog-refresh.js",
    "market:ingest": "node dist/market-ingest.js",
    "market:stream": "node dist/market-stream.js",
    "market:retain": "node dist/market-retain.js",
    "dataset": "node dist/dataset.js",
    "opportunity:detect": "node dist/opportunity-detect.js",
    "lint": "eslint src --max-warnings=0",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.11",
    "@nestjs/core": "^11.1.11",
    "@quant-lab/database": "workspace:*",
    "@quant-lab/exchange-adapters": "workspace:*",
    "@quant-lab/market-catalog": "workspace:*",
    "@quant-lab/market-ingestion": "workspace:*",
    "@quant-lab/market-data": "workspace:*",
    "@quant-lab/shared": "workspace:*",
    "@quant-lab/strategy-engine": "workspace:*",
    "dotenv": "^17.2.3",
    "pino": "^10.1.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.16",
    "@types/node": "^20.19.27",
    "typescript": "^5.9.3",
    "vitest": "^4.0.16"
  }
}
