generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model PlatformEvent {
  id          String    @id @default(uuid()) @db.Uuid
  source      String
  eventType   String
  eventTime   DateTime? @db.Timestamptz(6)
  receivedAt  DateTime  @db.Timestamptz(6)
  processedAt DateTime? @db.Timestamptz(6)
  payload     Json
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)

  @@index([source, eventType, eventTime])
}

model Venue {
  id           String                  @id
  code         String                  @unique
  name         String
  kind         String
  status       String
  createdAt    DateTime                @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime                @updatedAt @db.Timestamptz(6)
  markets      Market[]
  aliases      MarketAlias[]
  capabilities CapabilitySnapshot[]
  clockDrifts  ClockDriftMeasurement[]
}

model ClockDriftMeasurement {
  id                    String   @id @default(uuid()) @db.Uuid
  venueId               String
  sampledAt             DateTime @db.Timestamptz(6)
  serverTime            DateTime @db.Timestamptz(6)
  driftMicroseconds     BigInt
  roundTripMicroseconds BigInt
  venue                 Venue    @relation(fields: [venueId], references: [id])

  @@index([venueId, sampledAt])
}

model Instrument {
  id              String   @id
  kind            String
  baseCurrency    String
  quoteCurrency   String
  canonicalSymbol String   @unique
  createdAt       DateTime @default(now()) @db.Timestamptz(6)
  markets         Market[]
}

model Market {
  id                String                  @id
  venueId           String
  instrumentId      String
  venueSymbol       String
  status            String
  spot              Boolean
  firstSeenAt       DateTime                @db.Timestamptz(6)
  lastSeenAt        DateTime                @db.Timestamptz(6)
  createdAt         DateTime                @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime                @updatedAt @db.Timestamptz(6)
  venue             Venue                   @relation(fields: [venueId], references: [id])
  instrument        Instrument              @relation(fields: [instrumentId], references: [id])
  aliases           MarketAlias[]
  tradingRules      TradingRuleVersion[]
  feeSchedules      FeeScheduleVersion[]
  tickers           MarketTicker[]
  trades            MarketTrade[]
  candles           MarketCandle[]
  orderBooks        MarketOrderBookEvent[]
  bookInvalidations OrderBookInvalidation[]
  datasetMarkets    DatasetMarket[]

  @@unique([venueId, venueSymbol])
  @@index([instrumentId, status, spot])
}

model DatasetManifest {
  id             String          @id
  checksum       String          @unique
  schemaVersion  String
  from           DateTime        @db.Timestamptz(6)
  to             DateTime        @db.Timestamptz(6)
  eventCount     Int
  sourceCoverage Json
  qualityReport  Json?
  createdAt      DateTime        @default(now()) @db.Timestamptz(6)
  validatedAt    DateTime?       @db.Timestamptz(6)
  pinnedAt       DateTime?       @db.Timestamptz(6)
  exportedAt     DateTime?       @db.Timestamptz(6)
  exportPath     String?
  compactedAt    DateTime?       @db.Timestamptz(6)
  markets        DatasetMarket[]
  events         DatasetEvent[]
  backtestRuns   BacktestRun[]

  @@index([createdAt])
  @@index([pinnedAt])
}

model BacktestExperiment {
  id         String        @id @default(uuid()) @db.Uuid
  name       String
  hypothesis String
  createdAt  DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime      @updatedAt @db.Timestamptz(6)
  runs       BacktestRun[]

  @@index([createdAt])
}

model BacktestRun {
  id              String             @id @default(uuid()) @db.Uuid
  experimentId    String             @db.Uuid
  datasetId       String
  status          String
  seed            Int
  codeCommit      String
  configuration   Json
  modelVersions   Json
  progress        Int                @default(0)
  totalEvents     Int                @default(0)
  pauseRequested  Boolean            @default(false)
  cancelRequested Boolean            @default(false)
  outputHash      String?
  metrics         Json?
  results         Json?
  error           String?
  createdAt       DateTime           @default(now()) @db.Timestamptz(6)
  startedAt       DateTime?          @db.Timestamptz(6)
  completedAt     DateTime?          @db.Timestamptz(6)
  updatedAt       DateTime           @updatedAt @db.Timestamptz(6)
  experiment      BacktestExperiment @relation(fields: [experimentId], references: [id])
  dataset         DatasetManifest    @relation(fields: [datasetId], references: [id])

  @@index([status, createdAt])
  @@index([experimentId, createdAt])
  @@index([datasetId, createdAt])
}

model PaperSession {
  id              String          @id @default(uuid()) @db.Uuid
  name            String
  status          String
  strategyVersion String
  codeCommit      String
  configuration   Json
  startedAt       DateTime?       @db.Timestamptz(6)
  stoppedAt       DateTime?       @db.Timestamptz(6)
  emergencyAt     DateTime?       @db.Timestamptz(6)
  createdAt       DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime        @updatedAt @db.Timestamptz(6)
  accounts        PaperAccount[]
  orders          PaperOrder[]
  alerts          PaperAlert[]
  campaigns       PaperCampaign[]

  @@index([status, createdAt])
}

model PaperAccount {
  id        String             @id @default(uuid()) @db.Uuid
  sessionId String             @db.Uuid
  venueId   String
  asset     String
  available Decimal            @db.Decimal(38, 18)
  reserved  Decimal            @db.Decimal(38, 18)
  updatedAt DateTime           @updatedAt @db.Timestamptz(6)
  session   PaperSession       @relation(fields: [sessionId], references: [id])
  entries   PaperLedgerEntry[]

  @@unique([sessionId, venueId, asset])
}

model PaperOrder {
  id                String       @id @default(uuid()) @db.Uuid
  sessionId         String       @db.Uuid
  idempotencyKey    String       @unique
  correlationId     String
  opportunityId     String?      @db.Uuid
  strategyVersion   String
  venueId           String
  marketId          String
  side              String
  status            String
  requestedQuantity Decimal      @db.Decimal(38, 18)
  filledQuantity    Decimal      @default(0) @db.Decimal(38, 18)
  averagePrice      Decimal?     @db.Decimal(38, 18)
  expectedProfit    Decimal?     @db.Decimal(38, 18)
  simulatedProfit   Decimal?     @db.Decimal(38, 18)
  rejectionReason   String?
  createdAt         DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime     @updatedAt @db.Timestamptz(6)
  session           PaperSession @relation(fields: [sessionId], references: [id])
  fills             PaperFill[]

  @@index([sessionId, createdAt])
  @@index([status, createdAt])
}

model PaperFill {
  id             String             @id @default(uuid()) @db.Uuid
  orderId        String             @db.Uuid
  idempotencyKey String             @unique
  quantity       Decimal            @db.Decimal(38, 18)
  price          Decimal            @db.Decimal(38, 18)
  fee            Decimal            @db.Decimal(38, 18)
  feeAsset       String
  occurredAt     DateTime           @db.Timestamptz(6)
  evidence       Json
  order          PaperOrder         @relation(fields: [orderId], references: [id])
  entries        PaperLedgerEntry[]

  @@index([orderId, occurredAt])
}

model PaperLedgerEntry {
  id        String       @id @default(uuid()) @db.Uuid
  accountId String       @db.Uuid
  fillId    String?      @db.Uuid
  groupId   String
  amount    Decimal      @db.Decimal(38, 18)
  reason    String
  createdAt DateTime     @default(now()) @db.Timestamptz(6)
  account   PaperAccount @relation(fields: [accountId], references: [id])
  fill      PaperFill?   @relation(fields: [fillId], references: [id])

  @@index([groupId])
  @@index([accountId, createdAt])
}

model PaperAlert {
  id         String       @id @default(uuid()) @db.Uuid
  sessionId  String       @db.Uuid
  severity   String
  code       String
  message    String
  details    Json?
  createdAt  DateTime     @default(now()) @db.Timestamptz(6)
  resolvedAt DateTime?    @db.Timestamptz(6)
  session    PaperSession @relation(fields: [sessionId], references: [id])

  @@index([sessionId, createdAt])
}

model PaperCampaign {
  id                   String       @id @default(uuid()) @db.Uuid
  sessionId            String       @db.Uuid
  name                 String
  status               String
  minimumDurationHours Int
  minimumSampleCount   Int
  startedAt            DateTime?    @db.Timestamptz(6)
  completedAt          DateTime?    @db.Timestamptz(6)
  decision             String?
  report               Json?
  createdAt            DateTime     @default(now()) @db.Timestamptz(6)
  session              PaperSession @relation(fields: [sessionId], references: [id])

  @@index([sessionId, createdAt])
}

model DatasetMarket {
  manifestId String
  marketId   String
  manifest   DatasetManifest @relation(fields: [manifestId], references: [id])
  market     Market          @relation(fields: [marketId], references: [id])

  @@id([manifestId, marketId])
  @@index([marketId])
}

model DatasetEvent {
  manifestId String
  ordinal    Int
  eventType  String
  sourceId   String
  occurredAt DateTime        @db.Timestamptz(6)
  checksum   String
  manifest   DatasetManifest @relation(fields: [manifestId], references: [id])

  @@id([manifestId, ordinal])
  @@unique([manifestId, eventType, sourceId])
  @@index([eventType, sourceId])
}

model MarketOrderBookEvent {
  id                  String                  @id @default(uuid()) @db.Uuid
  idempotencyKey      String                  @unique
  marketId            String
  venueId             String
  kind                String
  sequence            String
  previousSequence    String?
  eventTime           DateTime?               @db.Timestamptz(6)
  receivedAt          DateTime                @db.Timestamptz(6)
  processedAt         DateTime                @db.Timestamptz(6)
  bids                Json
  asks                Json
  checksum            String?
  depth               Int
  rawEnvelopeId       String                  @db.Uuid
  market              Market                  @relation(fields: [marketId], references: [id])
  opportunitiesAsBuy  ObservedOpportunity[]   @relation("OpportunityBuyBook")
  opportunitiesAsSell ObservedOpportunity[]   @relation("OpportunitySellBook")
  executableAsBuy     ExecutableOpportunity[] @relation("ExecutableBuyBook")
  executableAsSell    ExecutableOpportunity[] @relation("ExecutableSellBook")

  @@unique([marketId, sequence, kind])
  @@index([marketId, eventTime, id])
  @@index([marketId, kind, processedAt])
}

model DetectorConfiguration {
  id                      String                  @id
  detectorId              String
  version                 String
  fingerprint             String                  @unique
  configuration           Json
  createdAt               DateTime                @default(now()) @db.Timestamptz(6)
  opportunities           ObservedOpportunity[]
  executableOpportunities ExecutableOpportunity[]

  @@unique([detectorId, version, fingerprint])
}

model ObservedOpportunity {
  id               String                @id @default(uuid()) @db.Uuid
  idempotencyKey   String                @unique
  configurationId  String
  canonicalSymbol  String
  classification   String
  direction        String
  buyMarketId      String
  sellMarketId     String
  buyBookEventId   String                @db.Uuid
  sellBookEventId  String                @db.Uuid
  buyPrice         Decimal?              @db.Decimal(38, 18)
  sellPrice        Decimal?              @db.Decimal(38, 18)
  observedSpread   Decimal?              @db.Decimal(38, 18)
  buyFreshnessMs   Int
  sellFreshnessMs  Int
  crossVenueSkewMs Int
  rejectionReason  String?
  evaluatedAt      DateTime              @db.Timestamptz(6)
  configuration    DetectorConfiguration @relation(fields: [configurationId], references: [id])
  buyBook          MarketOrderBookEvent  @relation("OpportunityBuyBook", fields: [buyBookEventId], references: [id])
  sellBook         MarketOrderBookEvent  @relation("OpportunitySellBook", fields: [sellBookEventId], references: [id])

  @@index([canonicalSymbol, evaluatedAt])
  @@index([classification, evaluatedAt])
  @@index([rejectionReason, evaluatedAt])
}

model ExecutableOpportunity {
  id                String                @id @default(uuid()) @db.Uuid
  idempotencyKey    String                @unique
  configurationId   String
  canonicalSymbol   String
  classification    String
  direction         String
  buyMarketId       String
  sellMarketId      String
  buyVenueId        String
  sellVenueId       String
  buyBookEventId    String                @db.Uuid
  sellBookEventId   String                @db.Uuid
  buyTakerFee       Decimal               @db.Decimal(38, 18)
  sellTakerFee      Decimal               @db.Decimal(38, 18)
  topOfBookSpread   Decimal?              @db.Decimal(38, 18)
  bestSize          Decimal?              @db.Decimal(38, 18)
  maxExecutableSize Decimal?              @db.Decimal(38, 18)
  grossProfit       Decimal?              @db.Decimal(38, 18)
  feeCost           Decimal?              @db.Decimal(38, 18)
  slippageCost      Decimal?              @db.Decimal(38, 18)
  netProfit         Decimal?              @db.Decimal(38, 18)
  netProfitRate     Decimal?              @db.Decimal(38, 18)
  sizeEvaluations   Json
  buyFreshnessMs    Int
  sellFreshnessMs   Int
  crossVenueSkewMs  Int
  rejectionReason   String?
  blockReason       String?
  evaluatedAt       DateTime              @db.Timestamptz(6)
  configuration     DetectorConfiguration @relation(fields: [configurationId], references: [id])
  buyBook           MarketOrderBookEvent  @relation("ExecutableBuyBook", fields: [buyBookEventId], references: [id])
  sellBook          MarketOrderBookEvent  @relation("ExecutableSellBook", fields: [sellBookEventId], references: [id])

  @@index([canonicalSymbol, evaluatedAt])
  @@index([classification, evaluatedAt])
  @@index([rejectionReason, evaluatedAt])
}

model OrderBookInvalidation {
  id         String   @id @default(uuid()) @db.Uuid
  marketId   String
  venueId    String
  sequence   String?
  reason     String
  details    Json?
  detectedAt DateTime @db.Timestamptz(6)
  market     Market   @relation(fields: [marketId], references: [id])

  @@index([marketId, detectedAt])
}

model RawMarketEnvelope {
  id              String    @id @default(uuid()) @db.Uuid
  idempotencyKey  String    @unique
  venueId         String
  marketId        String
  eventType       String
  eventTime       DateTime? @db.Timestamptz(6)
  receivedAt      DateTime  @db.Timestamptz(6)
  processedAt     DateTime  @db.Timestamptz(6)
  sourcePrecision String
  payload         Json
  checksum        String
  createdAt       DateTime  @default(now()) @db.Timestamptz(6)

  @@index([marketId, eventType, eventTime])
}

model MarketTicker {
  id             String    @id @default(uuid()) @db.Uuid
  idempotencyKey String    @unique
  marketId       String
  eventTime      DateTime? @db.Timestamptz(6)
  receivedAt     DateTime  @db.Timestamptz(6)
  processedAt    DateTime  @db.Timestamptz(6)
  bid            Decimal?  @db.Decimal(38, 18)
  bidQuantity    Decimal?  @db.Decimal(38, 18)
  ask            Decimal?  @db.Decimal(38, 18)
  askQuantity    Decimal?  @db.Decimal(38, 18)
  last           Decimal?  @db.Decimal(38, 18)
  rawEnvelopeId  String    @db.Uuid
  market         Market    @relation(fields: [marketId], references: [id])

  @@index([marketId, eventTime, id])
}

model MarketTrade {
  id             String    @id @default(uuid()) @db.Uuid
  idempotencyKey String    @unique
  marketId       String
  venueTradeId   String
  side           String
  price          Decimal   @db.Decimal(38, 18)
  quantity       Decimal   @db.Decimal(38, 18)
  eventTime      DateTime? @db.Timestamptz(6)
  receivedAt     DateTime  @db.Timestamptz(6)
  processedAt    DateTime  @db.Timestamptz(6)
  rawEnvelopeId  String    @db.Uuid
  market         Market    @relation(fields: [marketId], references: [id])

  @@unique([marketId, venueTradeId])
  @@index([marketId, eventTime, id])
}

model MarketCandle {
  id             String   @id @default(uuid()) @db.Uuid
  idempotencyKey String   @unique
  marketId       String
  interval       String
  openedAt       DateTime @db.Timestamptz(6)
  closedAt       DateTime @db.Timestamptz(6)
  open           Decimal  @db.Decimal(38, 18)
  high           Decimal  @db.Decimal(38, 18)
  low            Decimal  @db.Decimal(38, 18)
  close          Decimal  @db.Decimal(38, 18)
  volume         Decimal  @db.Decimal(38, 18)
  tradeCount     String?
  receivedAt     DateTime @db.Timestamptz(6)
  processedAt    DateTime @db.Timestamptz(6)
  rawEnvelopeId  String   @db.Uuid
  market         Market   @relation(fields: [marketId], references: [id])

  @@unique([marketId, interval, openedAt])
  @@index([marketId, interval, openedAt, id])
}

model MarketAlias {
  id        String    @id @default(uuid()) @db.Uuid
  venueId   String
  marketId  String
  alias     String
  validFrom DateTime  @db.Timestamptz(6)
  validTo   DateTime? @db.Timestamptz(6)
  venue     Venue     @relation(fields: [venueId], references: [id])
  market    Market    @relation(fields: [marketId], references: [id])

  @@unique([venueId, alias, validFrom])
  @@index([marketId, validTo])
}

model TradingRuleVersion {
  id                String   @id @default(uuid()) @db.Uuid
  marketId          String
  fingerprint       String
  priceIncrement    Decimal  @db.Decimal(38, 18)
  quantityIncrement Decimal  @db.Decimal(38, 18)
  minimumQuantity   Decimal? @db.Decimal(38, 18)
  maximumQuantity   Decimal? @db.Decimal(38, 18)
  minimumNotional   Decimal? @db.Decimal(38, 18)
  effectiveAt       DateTime @db.Timestamptz(6)
  market            Market   @relation(fields: [marketId], references: [id])

  @@unique([marketId, fingerprint])
  @@index([marketId, effectiveAt])
}

model FeeScheduleVersion {
  id          String   @id @default(uuid()) @db.Uuid
  marketId    String
  fingerprint String
  maker       Decimal  @db.Decimal(38, 18)
  taker       Decimal  @db.Decimal(38, 18)
  source      String
  effectiveAt DateTime @db.Timestamptz(6)
  market      Market   @relation(fields: [marketId], references: [id])

  @@unique([marketId, fingerprint])
  @@index([marketId, effectiveAt])
}

model CapabilitySnapshot {
  id           String   @id @default(uuid()) @db.Uuid
  venueId      String
  fingerprint  String
  capabilities Json
  observedAt   DateTime @db.Timestamptz(6)
  venue        Venue    @relation(fields: [venueId], references: [id])

  @@unique([venueId, fingerprint])
  @@index([venueId, observedAt])
}
