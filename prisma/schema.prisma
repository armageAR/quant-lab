generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model PlatformEvent {
  id          String    @id @default(uuid()) @db.Uuid
  source      String
  eventType   String
  eventTime   DateTime? @db.Timestamptz(6)
  receivedAt  DateTime  @db.Timestamptz(6)
  processedAt DateTime? @db.Timestamptz(6)
  payload     Json
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)

  @@index([source, eventType, eventTime])
}

model Venue {
  id           String                  @id
  code         String                  @unique
  name         String
  kind         String
  status       String
  createdAt    DateTime                @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime                @updatedAt @db.Timestamptz(6)
  markets      Market[]
  aliases      MarketAlias[]
  capabilities CapabilitySnapshot[]
  clockDrifts  ClockDriftMeasurement[]
}

model ClockDriftMeasurement {
  id                    String   @id @default(uuid()) @db.Uuid
  venueId               String
  sampledAt             DateTime @db.Timestamptz(6)
  serverTime            DateTime @db.Timestamptz(6)
  driftMicroseconds     BigInt
  roundTripMicroseconds BigInt
  venue                 Venue    @relation(fields: [venueId], references: [id])

  @@index([venueId, sampledAt])
}

model Instrument {
  id              String   @id
  kind            String
  baseCurrency    String
  quoteCurrency   String
  canonicalSymbol String   @unique
  createdAt       DateTime @default(now()) @db.Timestamptz(6)
  markets         Market[]
}

model Market {
  id           String               @id
  venueId      String
  instrumentId String
  venueSymbol  String
  status       String
  spot         Boolean
  firstSeenAt  DateTime             @db.Timestamptz(6)
  lastSeenAt   DateTime             @db.Timestamptz(6)
  createdAt    DateTime             @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime             @updatedAt @db.Timestamptz(6)
  venue        Venue                @relation(fields: [venueId], references: [id])
  instrument   Instrument           @relation(fields: [instrumentId], references: [id])
  aliases      MarketAlias[]
  tradingRules TradingRuleVersion[]
  feeSchedules FeeScheduleVersion[]
  tickers      MarketTicker[]
  trades       MarketTrade[]
  candles      MarketCandle[]
  orderBooks   MarketOrderBookEvent[]
  bookInvalidations OrderBookInvalidation[]

  @@unique([venueId, venueSymbol])
  @@index([instrumentId, status, spot])
}

model MarketOrderBookEvent {
  id               String   @id @default(uuid()) @db.Uuid
  idempotencyKey   String   @unique
  marketId         String
  venueId          String
  kind             String
  sequence         String
  previousSequence String?
  eventTime        DateTime? @db.Timestamptz(6)
  receivedAt       DateTime  @db.Timestamptz(6)
  processedAt      DateTime  @db.Timestamptz(6)
  bids             Json
  asks             Json
  checksum         String?
  depth            Int
  rawEnvelopeId    String   @db.Uuid
  market           Market   @relation(fields: [marketId], references: [id])

  @@unique([marketId, sequence, kind])
  @@index([marketId, eventTime, id])
  @@index([marketId, kind, processedAt])
}

model OrderBookInvalidation {
  id         String   @id @default(uuid()) @db.Uuid
  marketId   String
  venueId    String
  sequence   String?
  reason     String
  details    Json?
  detectedAt DateTime @db.Timestamptz(6)
  market     Market   @relation(fields: [marketId], references: [id])

  @@index([marketId, detectedAt])
}

model RawMarketEnvelope {
  id              String    @id @default(uuid()) @db.Uuid
  idempotencyKey  String    @unique
  venueId         String
  marketId        String
  eventType       String
  eventTime       DateTime? @db.Timestamptz(6)
  receivedAt      DateTime  @db.Timestamptz(6)
  processedAt     DateTime  @db.Timestamptz(6)
  sourcePrecision String
  payload         Json
  checksum        String
  createdAt       DateTime  @default(now()) @db.Timestamptz(6)

  @@index([marketId, eventType, eventTime])
}

model MarketTicker {
  id             String    @id @default(uuid()) @db.Uuid
  idempotencyKey String    @unique
  marketId       String
  eventTime      DateTime? @db.Timestamptz(6)
  receivedAt     DateTime  @db.Timestamptz(6)
  processedAt    DateTime  @db.Timestamptz(6)
  bid            Decimal?  @db.Decimal(38, 18)
  bidQuantity    Decimal?  @db.Decimal(38, 18)
  ask            Decimal?  @db.Decimal(38, 18)
  askQuantity    Decimal?  @db.Decimal(38, 18)
  last           Decimal?  @db.Decimal(38, 18)
  rawEnvelopeId  String    @db.Uuid
  market         Market    @relation(fields: [marketId], references: [id])

  @@index([marketId, eventTime, id])
}

model MarketTrade {
  id             String    @id @default(uuid()) @db.Uuid
  idempotencyKey String    @unique
  marketId       String
  venueTradeId   String
  side           String
  price          Decimal   @db.Decimal(38, 18)
  quantity       Decimal   @db.Decimal(38, 18)
  eventTime      DateTime? @db.Timestamptz(6)
  receivedAt     DateTime  @db.Timestamptz(6)
  processedAt    DateTime  @db.Timestamptz(6)
  rawEnvelopeId  String    @db.Uuid
  market         Market    @relation(fields: [marketId], references: [id])

  @@unique([marketId, venueTradeId])
  @@index([marketId, eventTime, id])
}

model MarketCandle {
  id             String   @id @default(uuid()) @db.Uuid
  idempotencyKey String   @unique
  marketId       String
  interval       String
  openedAt       DateTime @db.Timestamptz(6)
  closedAt       DateTime @db.Timestamptz(6)
  open           Decimal  @db.Decimal(38, 18)
  high           Decimal  @db.Decimal(38, 18)
  low            Decimal  @db.Decimal(38, 18)
  close          Decimal  @db.Decimal(38, 18)
  volume         Decimal  @db.Decimal(38, 18)
  tradeCount     String?
  receivedAt     DateTime @db.Timestamptz(6)
  processedAt    DateTime @db.Timestamptz(6)
  rawEnvelopeId  String   @db.Uuid
  market         Market   @relation(fields: [marketId], references: [id])

  @@unique([marketId, interval, openedAt])
  @@index([marketId, interval, openedAt, id])
}

model MarketAlias {
  id        String    @id @default(uuid()) @db.Uuid
  venueId   String
  marketId  String
  alias     String
  validFrom DateTime  @db.Timestamptz(6)
  validTo   DateTime? @db.Timestamptz(6)
  venue     Venue     @relation(fields: [venueId], references: [id])
  market    Market    @relation(fields: [marketId], references: [id])

  @@unique([venueId, alias, validFrom])
  @@index([marketId, validTo])
}

model TradingRuleVersion {
  id                String   @id @default(uuid()) @db.Uuid
  marketId          String
  fingerprint       String
  priceIncrement    Decimal  @db.Decimal(38, 18)
  quantityIncrement Decimal  @db.Decimal(38, 18)
  minimumQuantity   Decimal? @db.Decimal(38, 18)
  maximumQuantity   Decimal? @db.Decimal(38, 18)
  minimumNotional   Decimal? @db.Decimal(38, 18)
  effectiveAt       DateTime @db.Timestamptz(6)
  market            Market   @relation(fields: [marketId], references: [id])

  @@unique([marketId, fingerprint])
  @@index([marketId, effectiveAt])
}

model FeeScheduleVersion {
  id          String   @id @default(uuid()) @db.Uuid
  marketId    String
  fingerprint String
  maker       Decimal  @db.Decimal(38, 18)
  taker       Decimal  @db.Decimal(38, 18)
  source      String
  effectiveAt DateTime @db.Timestamptz(6)
  market      Market   @relation(fields: [marketId], references: [id])

  @@unique([marketId, fingerprint])
  @@index([marketId, effectiveAt])
}

model CapabilitySnapshot {
  id           String   @id @default(uuid()) @db.Uuid
  venueId      String
  fingerprint  String
  capabilities Json
  observedAt   DateTime @db.Timestamptz(6)
  venue        Venue    @relation(fields: [venueId], references: [id])

  @@unique([venueId, fingerprint])
  @@index([venueId, observedAt])
}
