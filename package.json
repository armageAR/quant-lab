{
  "name": "quant-lab",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.26.2",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev --concurrency 20",
    "lint": "turbo lint",
    "test": "turbo test",
    "test:integration": "pnpm --filter @quant-lab/database test:integration && pnpm --filter @quant-lab/market-catalog test:integration && pnpm --filter @quant-lab/market-ingestion test:integration && pnpm --filter @quant-lab/analytics test:integration && pnpm --filter @quant-lab/simulation test:integration && pnpm --filter @quant-lab/paper-trading test:integration",
    "test:process": "node scripts/check-process-lifecycle.mjs",
    "test:exchange": "pnpm --filter @quant-lab/exchange-adapters test:integration",
    "exchange:check": "pnpm --filter @quant-lab/exchange-adapters build && pnpm --filter @quant-lab/exchange-adapters connectivity",
    "catalog:refresh": "turbo build --filter=@quant-lab/worker && pnpm --filter @quant-lab/worker catalog:refresh",
    "market:ingest": "turbo build --filter=@quant-lab/worker && pnpm --filter @quant-lab/worker market:ingest",
    "market:stream": "turbo build --filter=@quant-lab/worker && pnpm --filter @quant-lab/worker market:stream",
    "market:retain": "turbo build --filter=@quant-lab/worker && pnpm --filter @quant-lab/worker market:retain",
    "dataset": "turbo build --filter=@quant-lab/worker && pnpm --filter @quant-lab/worker dataset",
    "opportunity:detect": "turbo build --filter=@quant-lab/worker && pnpm --filter @quant-lab/worker opportunity:detect",
    "opportunity:detect:executable": "turbo build --filter=@quant-lab/worker && pnpm --filter @quant-lab/worker opportunity:detect:executable",
    "research:report": "turbo build --filter=@quant-lab/worker && pnpm --filter @quant-lab/worker research:report",
    "typecheck": "turbo typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "docs:check": "node scripts/check-markdown-links.mjs",
    "check": "pnpm format:check && pnpm docs:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "check:ci": "pnpm db:deploy && pnpm check && pnpm test:integration && pnpm test:process && prisma migrate status"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/node": "^20.19.27",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.5.0",
    "pnpm": "10.26.2",
    "prettier": "^3.7.4",
    "prisma": "^6.19.1",
    "turbo": "^2.7.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.50.1",
    "vitest": "^4.0.16"
  },
  "dependencies": {
    "@prisma/client": "^6.19.1"
  }
}
