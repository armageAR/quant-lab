  "build": {
    "buildCommand": "cd /var/www/html/quant-lab\npnpm build --filter=@quant-lab/api --filter=@quant-lab/worker --filter=@quant-lab/dashboard 2>&1 | tail -12\necho \"=== server dist present (not started) ===\"\nls apps/api/dist/main.js apps/worker/dist/main.js 2>&1\necho \"=== confirm no server process running ===\"; pgrep -af \"dist/main.js\" 2>/dev/null || echo \"no server process running\"",
    "testCommand": "cd /var/www/html/quant-lab\nSCR=/tmp/claude-1000/-var-www-html-quant-lab/cdc75b7f-b409-4842-8613-c02f840d619c/scratchpad\npnpm check > $SCR/main-check.log 2>&1; echo \"CHECK_EXIT=$?\"\npnpm test:integration > $SCR/main-integration.log 2>&1; echo \"INTEGRATION_EXIT=$?\"\npnpm test:process > $SCR/main-process.log 2>&1; echo \"PROCESS_EXIT=$?\"\necho \"=== check summary ===\"; grep -E \"Tasks:|error|ERR_\" $SCR/main-check.log | grep -viE \"probe fails|✓\" | tail -5\necho \"=== integration summary ===\"; tail -4 $SCR/main-integration.log\necho \"=== process summary ===\"; tail -2 $SCR/main-process.log",
    "lintCommand": "pnpm lint",
    "devCommand": "pnpm dev",
    "scripts": {
      "build": "turbo build",
      "dev": "turbo dev --concurrency 20",
      "lint": "turbo lint",
      "test": "turbo test",
      "test:integration": "pnpm --filter @quant-lab/database test:integration && pnpm --filter @quant-lab/market-catalog test:integration && pnpm --filter @quant-lab/market-ingestion test:integration",
      "test:process": "node scripts/check-process-lifecycle.mjs",
      "test:exchange": "pnpm --filter @quant-lab/exchange-adapters test:integration",
      "exchange:check": "pnpm --filter @quant-lab/exchange-adapters build && pnpm --filter @quant-lab/exchange-adapters connectivity",
      "catalog:refresh": "turbo build --filter=@quant-lab/worker && pnpm --filter @quant-lab/worker catalog:refresh",
      "market:ingest": "turbo build --filter=@quant-lab/worker && pnpm --filter @quant-lab/worker market:ingest",
      "market:stream": "turbo build --filter=@quant-lab/worker && pnpm --filter @quant-lab/worker market:stream",
      "market:retain": "turbo build --filter=@quant-lab/worker && pnpm --filter @quant-lab/worker market:retain",
      "dataset": "turbo build --filter=@quant-lab/worker && pnpm --filter @quant-lab/worker dataset",
      "opportunity:detect": "turbo build --filter=@quant-lab/worker && pnpm --filter @quant-lab/worker opportunity:detect",
      "typecheck": "turbo typecheck",
      "format": "prettier --write .",
      "format:check": "prettier --check .",
      "db:generate": "prisma generate",
      "db:migrate": "prisma migrate dev",
      "db:deploy": "prisma migrate deploy",
      "db:studio": "prisma studio",
      "docs:check": "node scripts/check-markdown-links.mjs",
      "check": "pnpm format:check && pnpm docs:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
      "check:ci": "pnpm db:deploy && pnpm check && pnpm test:integration && pnpm test:process && prisma migrate status"
    }
  },
