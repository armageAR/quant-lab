    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check": "node dist/cli.js"
  },
  "dependencies": {
    "@quant-lab/shared": "workspace:*",
    "@stoqey/ib": "^1.4.0",
    "dotenv": "^17.4.2",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@types/node": "^20.19.27",
    "typescript": "^5.9.3",
    "vitest": "^4.0.16"
  }
}
