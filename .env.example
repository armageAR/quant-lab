NODE_ENV=development
PORT=3000
WORKER_HEALTH_PORT=3002
BACKTEST_POLL_INTERVAL_MS=1000

DATABASE_URL=postgresql://quant_lab:quant_lab@localhost:5432/quant_lab

LOG_LEVEL=info
LOG_FORMAT=pretty

EXCHANGE_CONNECTIVITY_ENABLED=false
# Configured allowlist of overlapping liquid spot markets (majors + mid-caps).
# Only symbols active on BOTH Binance and Kraken produce cross-venue analysis;
# USD/USDT/USDC are distinct canonical quotes. Catalog refresh prunes any that
# are not listed on both venues.
EXCHANGE_MARKETS=BTC/USDT,ETH/USDT,SOL/USDT,XRP/USDT,ADA/USDT,DOGE/USDT,LTC/USDT,BCH/USDT,DOT/USDT,LINK/USDT,AVAX/USDT,ATOM/USDT,BTC/USDC,ETH/USDC,SOL/USDC,XRP/USDC,ADA/USDC,DOGE/USDC,LTC/USDC
EXCHANGE_TIMEOUT_MS=10000
EXCHANGE_RETRY_ATTEMPTS=3
EXCHANGE_CIRCUIT_FAILURES=3
EXCHANGE_CIRCUIT_RESET_MS=30000
INGESTION_STREAM_DURATION_MS=60000
MARKET_DATA_RETENTION_DAYS=90
OBSERVED_DETECTOR_VERSION=1.0.0
OBSERVED_MAX_BOOK_AGE_MS=5000
OBSERVED_MAX_SKEW_MS=1000
OBSERVED_MIN_SPREAD=0
OBSERVATION_LOOP_ENABLED=true
OBSERVATION_INTERVAL_MS=10000
OBSERVATION_CATALOG_REFRESH_MS=3600000
OBSERVATION_ORDER_BOOK_DEPTH=100
OBSERVATION_MAX_BACKOFF_MS=60000

# Executable opportunity detector (Sprint 3.2). Disabled by default; when
# enabled the observation worker also estimates realizable net profit.
# Inventory is a JSON object of venueId -> currency -> available amount. A venue
# absent from the map is treated as unconstrained; an empty object enforces no
# inventory limits.
EXECUTABLE_DETECTOR_ENABLED=false
EXECUTABLE_DETECTOR_VERSION=1.0.0
EXECUTABLE_MAX_BOOK_AGE_MS=5000
EXECUTABLE_MAX_SKEW_MS=1000
EXECUTABLE_TRADE_SIZES=0.01,0.1,1
EXECUTABLE_SLIPPAGE_BUFFER=0.0005
EXECUTABLE_LATENCY_BUFFER_MS=250
EXECUTABLE_MIN_NET_PROFIT_RATE=0
EXECUTABLE_INVENTORY={}

# Research report (Sprint 3.3). Latency study and backtest-eligibility gate.
# submission delay is the simulated time to reach a venue; executable episodes
# shorter than it are treated as removed by latency. A dataset qualifies for
# backtesting only when all thresholds pass.
RESEARCH_SUBMISSION_DELAY_MS=1000
RESEARCH_EPISODE_GAP_MS=20000
RESEARCH_MIN_EXECUTABLE_COUNT=10
RESEARCH_MAX_FALSE_POSITIVE_RATE=0.9
RESEARCH_MIN_MEDIAN_DURATION_MS=1000

BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_SANDBOX=true
BINANCE_INTEGRATION_ENABLED=false

KRAKEN_API_KEY=
KRAKEN_API_SECRET=
KRAKEN_SANDBOX=false
KRAKEN_INTEGRATION_ENABLED=false

LIVE_EXECUTION_ENABLED=false

# IBKR paper-only connectivity. No port or account has an unsafe default.
IBKR_CONNECTIVITY_ENABLED=false
IBKR_ENVIRONMENT=paper
IBKR_READ_ONLY=true
IBKR_PAPER_ENABLED=false
IBKR_PAPER_EXECUTION_ENABLED=false
IBKR_HOST=127.0.0.1
IBKR_PORT=
IBKR_CLIENT_ID=
IBKR_ACCOUNT_ID=
IBKR_CONTRACT_IDS=
IBKR_TIMEOUT_MS=10000
IBKR_RECONNECT_MS=5000
IBKR_MAX_REQUESTS_PER_SECOND=20
IBKR_REGULAR_TRADING_HOURS_ONLY=true
